[Unit]
Description=luxctl Phase 0 recorder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/luxctl
# The token lives outside the repository, in a root-owned 0600 file, so it
# cannot be committed by accident. See the Deployment section of README.md.
EnvironmentFile=/etc/luxctl.env
ExecStart=/home/pi/luxctl/.venv/bin/luxctl --config sensors.toml --db data/luxctl.db
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
